// Windows のリソーススクリプト。実行ファイル自体にアイコンを埋め込む。
//
// ウィンドウのアイコン（glfwSetWindowIcon / app_icon.cpp）とは別物で、こちらは
// エクスプローラー上でのファイルの見た目や、タスクバーにピン留めしたときの表示に
// 使われる。両方ないと Windows では見た目が揃わない。
//
// このファイルは CMake が configure_file でビルドディレクトリへ展開する。.ico を
// 絶対パスで指すためで、rc コンパイラの相対パス解決は処理系によって差があり当てに
// できない（MSVC の rc.exe と MinGW の windres で基準ディレクトリが違う）。

// アイコンリソースの ID。Windows は「最も小さい ID のアイコン」を実行ファイルの
// 代表アイコンとして使うので、別のアイコンを追加するときは番号に注意すること。
#define IDI_APP_ICON 101

IDI_APP_ICON ICON "@MORPHINGALIGNER_ICO@"
